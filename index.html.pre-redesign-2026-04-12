        <aside class="card fade-in d2" aria-label="lab snapshot">
          <h2 style="margin-top:0; font-size:1.1rem;">Lab Snapshot</h2>
          <p style="margin:0; color:var(--muted); line-height:1.6;">
            A five-host environment built for development, services, and continuous tinkering.
          </p>
          <div class="stat-grid">
            <div class="stat"><div class="n">5</div><div class="k">Hosts</div></div>
