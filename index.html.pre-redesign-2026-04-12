<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Halfax Infrastructure | Home Lab + Projects</title>
  <meta name="description" content="Personal website for Halfax: home lab, gaming development laptop, and software projects.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0f1115;
      --panel: #151923;
      --panel-2: #1b2130;
      --ink: #edf2f7;
      --muted: #9ea9ba;
      --line: #2a3245;
      --aqua: #3dd7c6;
      --amber: #ffb44d;
      --coral: #ff6e5b;
      --sky: #62a0ff;
      --max: 1120px;
      --radius: 16px;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: radial-gradient(circle at 10% -10%, #21314c 0%, transparent 34%),
                  radial-gradient(circle at 85% 10%, #33263d 0%, transparent 28%),
                  linear-gradient(180deg, #0d1016, #10141d 42%, #0f1115 100%);
      color: var(--ink);
      font-family: "Space Grotesk", "Segoe UI", sans-serif;
      scroll-behavior: smooth;
    }

    a { color: inherit; }

    .wrap {
      width: min(var(--max), 92vw);
      margin: 0 auto;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      backdrop-filter: blur(8px);
      background: rgba(15, 17, 21, 0.72);
      border-bottom: 1px solid rgba(158, 169, 186, 0.15);
    }

    .topbar-inner {
      width: min(var(--max), 92vw);
      margin: 0 auto;
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .brand-dot {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--aqua), var(--amber));
      box-shadow: 0 0 18px rgba(61, 215, 198, 0.65);
      animation: pulse 2.6s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.25); opacity: 0.75; }
    }

    .nav {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      justify-content: flex-end;
    }

    .nav a {
      text-decoration: none;
      color: var(--muted);
      font-size: 0.92rem;
      transition: color 0.2s ease;
    }

    .nav a:hover { color: var(--ink); }

    .hero {
      padding: 82px 0 48px;
      position: relative;
      overflow: hidden;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 26px;
      align-items: stretch;
    }

    .hero h1 {
      margin: 0 0 16px;
      font-size: clamp(2rem, 4.8vw, 4rem);
      line-height: 1.04;
      letter-spacing: 0.2px;
    }

    .hero h1 .accent { color: var(--aqua); }

    .lede {
      color: #d8e0eb;
      max-width: 64ch;
      font-size: 1.06rem;
      line-height: 1.7;
      margin-bottom: 20px;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 24px;
    }

    .hero-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 14px;
    }

    .quick-btn {
      text-decoration: none;
      padding: 10px 14px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 0.88rem;
      color: #071018;
      transition: transform 0.18s ease, opacity 0.2s ease;
      box-shadow: 0 7px 20px rgba(0, 0, 0, 0.24);
    }

    .quick-btn:hover {
      transform: translateY(-2px);
      opacity: 0.94;
    }

    .quick-btn.ai { background: linear-gradient(135deg, #62a0ff, #8f7cff); }
    .quick-btn.photo { background: linear-gradient(135deg, #40d9b1, #3dd7c6); }
    .quick-btn.story { background: linear-gradient(135deg, #ffb44d, #ff6e5b); }
    .quick-btn.main { background: linear-gradient(135deg, #4fd1ff, #62a0ff); }
    .quick-btn.shop { background: linear-gradient(135deg, #ff8fb8, #ff6e8d); }

    .chip {
      border: 1px solid rgba(158, 169, 186, 0.3);
      color: var(--muted);
      padding: 7px 12px;
      border-radius: 999px;
      font-size: 0.82rem;
      background: rgba(255, 255, 255, 0.02);
    }

    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      border: 1px solid transparent;
      text-decoration: none;
      padding: 11px 16px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.94rem;
      transition: transform 0.18s ease, box-shadow 0.2s ease, opacity 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 9px;
    }

    .btn:hover {
      transform: translateY(-2px);
      opacity: 0.96;
    }

    .btn.primary {
      background: linear-gradient(135deg, var(--aqua), var(--sky));
      color: #081018;
      box-shadow: 0 8px 24px rgba(61, 215, 198, 0.22);
    }

    .btn.secondary {
      border-color: rgba(158, 169, 186, 0.45);
      color: var(--ink);
      background: rgba(255, 255, 255, 0.03);
    }

    .card {
      background: linear-gradient(160deg, var(--panel), var(--panel-2));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.22);
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 10px;
    }

    .stat {
      border: 1px solid rgba(158, 169, 186, 0.26);
      border-radius: 12px;
      padding: 12px;
      background: rgba(255, 255, 255, 0.02);
    }

    .stat .n {
      font-size: 1.6rem;
      font-weight: 700;
      margin-bottom: 2px;
      color: var(--amber);
    }

    .stat .k {
      color: var(--muted);
      font-size: 0.86rem;
    }

    .section {
      padding: 14px 0 20px;
    }

    .section h2 {
      font-size: clamp(1.38rem, 2.6vw, 2.1rem);
      margin: 0 0 14px;
    }

    .section p.section-copy {
      color: var(--muted);
      margin: 0 0 16px;
      line-height: 1.7;
      max-width: 80ch;
    }

    .lab-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .node h3 {
      margin: 0 0 8px;
      font-size: 1.03rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .node .role {
      color: var(--muted);
      font-size: 0.82rem;
      font-family: "IBM Plex Mono", monospace;
    }

    .node ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .node li {
      color: #d4deed;
      padding: 6px 0;
      border-top: 1px dashed rgba(158, 169, 186, 0.24);
      font-size: 0.95rem;
    }

    .node li:first-child { border-top: none; }

    .proj-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-top: 14px;
    }

    .catalog h3 {
      margin: 0 0 8px;
      font-size: 1.03rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .catalog .count {
      color: var(--muted);
      font-size: 0.82rem;
      font-family: "IBM Plex Mono", monospace;
      font-weight: 500;
    }

    .catalog ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .catalog li {
      border-top: 1px dashed rgba(158, 169, 186, 0.24);
      padding: 6px 0;
      color: #d7e0ee;
      font-size: 0.92rem;
    }

    .catalog li:first-child { border-top: none; }

    .proj h3 {
      margin: 0 0 7px;
      font-size: 1.03rem;
    }

    .proj p {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
      font-size: 0.95rem;
    }

    .links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 14px;
    }

    .link-tile {
      text-decoration: none;
      padding: 14px;
      border-radius: 12px;
      border: 1px solid rgba(158, 169, 186, 0.33);
      background: rgba(255, 255, 255, 0.03);
      transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .link-tile:hover {
      transform: translateY(-2px);
      border-color: rgba(98, 160, 255, 0.8);
    }

    .link-tile strong {
      display: block;
      margin-bottom: 4px;
      font-size: 0.96rem;
    }

    .link-tile span {
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.55;
    }

    .safe-note {
      margin-top: 18px;
      border-left: 3px solid var(--aqua);
      padding: 9px 12px;
      color: #c9d6e7;
      background: rgba(61, 215, 198, 0.08);
      border-radius: 8px;
      font-size: 0.9rem;
    }

    footer {
      margin: 30px 0 52px;
      border-top: 1px solid rgba(158, 169, 186, 0.2);
      padding-top: 18px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 0.88rem;
    }

    .fade-in {
      opacity: 0;
      transform: translateY(14px);
      animation: rise 0.65s ease forwards;
    }

    .fade-in.d2 { animation-delay: 0.12s; }
    .fade-in.d3 { animation-delay: 0.24s; }

    @keyframes rise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 980px) {
      .hero-grid,
      .lab-grid,
      .proj-grid,
      .catalog-grid,
      .links {
        grid-template-columns: 1fr;
      }

      .topbar-inner {
        padding: 10px 0;
        align-items: flex-start;
        flex-direction: column;
      }

      .hero {
        padding-top: 58px;
      }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="#top">
        <span class="brand-dot" aria-hidden="true"></span>
        <span>Halfax Infrastructure</span>
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="#lab">Home Lab</a>
        <a href="#hardware">Hardware</a>
        <a href="#projects">Projects</a>
        <a href="#links">Links</a>
      </nav>
